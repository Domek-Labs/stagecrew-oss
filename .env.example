# Copy to .env (gitignored) and fill in real values locally. Never commit a
# real value for any of these.
#
# This file is a reference for what to set, not something any script here
# loads automatically — ops/release-mirror.js reads only process.env, never
# a .env file. Get the value into the environment yourself before running
# it, e.g.:
#   export RELEASE_MIRROR_TOKEN=<your-token>
# or, to load everything from a local .env in one shot:
#   set -a; . ./.env; set +a

# Push credential for ops/release-mirror.js. A GitHub token (classic PAT or
# fine-grained PAT) scoped to push access on the target mirror repo
# (Domek-Labs/stagecrew-oss by default, see --target). Read from the
# environment only — never written to a committed file. See
# docs/adr/0027-public-release-mirror.md for how it is used (a throwaway
# GIT_ASKPASS script, never a child-process argument, never printed).
RELEASE_MIRROR_TOKEN=
